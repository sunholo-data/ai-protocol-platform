<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<a:theme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="Loud Template">
  <a:themeElements>
    <a:clrScheme name="Loud">
      <a:dk1><a:sysClr val="windowText" lastClr="000000"/></a:dk1>
      <a:lt1><a:sysClr val="window" lastClr="FFFFFF"/></a:lt1>
      <a:dk2><a:srgbClr val="4B0082"/></a:dk2>
      <a:lt2><a:srgbClr val="FFF2CC"/></a:lt2>
      <a:accent1><a:srgbClr val="FF00AA"/></a:accent1>
      <a:accent2><a:srgbClr val="FF6600"/></a:accent2>
      <a:accent3><a:srgbClr val="00A0A0"/></a:accent3>
      <a:accent4><a:srgbClr val="FFDD00"/></a:accent4>
      <a:accent5><a:srgbClr val="D40000"/></a:accent5>
      <a:accent6><a:srgbClr val="7700FF"/></a:accent6>
