**/.claude/settings.local.json

# Debug
/debug_images/
.claude/scheduled_tasks.lock
backend/aitana_platform/

# Locked agent worktrees from parallel sub-agent execution. The harness
# manages these; they're never committed and shouldn't block sanitize.
.claude/worktrees/

# AILANG WASM runtime + deontic engine, fetched by scripts/fetch-ailang-wasm.sh
# into the ppa-obligation-analysis artefact (7.6). The ~40 MB ailang.wasm is
# NEVER committed — CI/local reconstitutes it from the pinned release. (Also
# ignored by the artefact's own assets/.gitignore; duplicated here for
# discoverability + defense-in-depth.)
infrastructure/mcp-sandbox/artefacts/*/v1/assets/ailang.wasm
infrastructure/mcp-sandbox/artefacts/*/v1/assets/ailang.wasm.br
infrastructure/mcp-sandbox/artefacts/*/v1/assets/wasm_exec.js
infrastructure/mcp-sandbox/artefacts/*/v1/assets/ailang-repl.js
infrastructure/mcp-sandbox/artefacts/*/v1/assets/engine/
infrastructure/mcp-sandbox/artefacts/*/v1/assets/.ailang-version

# MCP Toolbox binary for local dev (make toolbox-install) — never commit the 150MB binary
.bin/

# TEMPLATE-INVERT M3: real-valued config generated from tracked .example files
# by scripts/materialize-config.sh. Tracking these would put generic content
# upstream and real content downstream at the SAME path — the permanent
# merge-conflict case the upstream/downstream split exists to remove.
infrastructure/mcp-toolbox/tools.yaml
docs/ops/deployed-urls.md
deploy.env
cli/aiplatform/config.yaml
# --force backups of the above
infrastructure/mcp-toolbox/tools.yaml.bak
docs/ops/deployed-urls.md.bak

# Local scratch — never committed. Somewhere to drop generated artefacts,
# customer samples and conversion output while inspecting them by hand.
.scratch/

# Built by `make loud-template` from the checked-in OOXML parts.
scripts/fixtures/loud_template/loud-template.docx

# AILANG's per-directory compile cache — a build artefact, never source.
**/.ailang/cache/

# Local AILANG voice preference (per-machine, not project config)
.ailang_voice

# Built by `make one-brand-template` from the checked-in OOXML parts.
# Customer-branded binary — never commit it (the parts are the reviewable source).
scripts/one-brand-template/*.docx

# User guide bundle — build outputs of scripts/user-guide/bundle.mjs (sources: docs/user-guide/, docs/customers/*/user-guide/)
/frontend/content/user-guide/
/frontend/public/help/img/
/backend/bundled/

# user-guide screenshot harness deps
/scripts/user-guide/shots/node_modules/
/scripts/user-guide/shots/package-lock.json
