# Dependencies
node_modules/
frontend/node_modules/
backend/.venv/
cli/.venv/
cli/dist/
cli/build/
__pycache__/
*.pyc

# Build
frontend/.next/
frontend/out/
*.egg-info/
dist/
build/

# Environment
.env
.env.local
.env.*.local
frontend/.env.local
backend/.env

