{
  "name": "ai-protocol-platform",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "predev": "[ ! -f ../scripts/user-guide/bundle.mjs ] || node ../scripts/user-guide/bundle.mjs",
    "dev": "next dev",
    "prebuild": "[ ! -f ../scripts/user-guide/bundle.mjs ] || node ../scripts/user-guide/bundle.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest",
    "pretest:run": "[ ! -f ../scripts/user-guide/bundle.mjs ] || node ../scripts/user-guide/bundle.mjs",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality:check": "npm run lint && npm run typecheck && CI=true npm run test:run && npm run build",
    "quality:check:fast": "npm run lint && npm run typecheck && npm run check:auth-fetch",
    "check:auth-fetch": "! grep -rn --include='*.ts' --include='*.tsx' 'fetch(`/api/proxy' src/hooks/ src/components/ src/app/ 2>/dev/null | grep -v fetchWithAuth | grep -v '//.*fetch' | grep -v '.test.' | grep .",
    "seed": "node src/scripts/seed-skills.mjs"
  },
